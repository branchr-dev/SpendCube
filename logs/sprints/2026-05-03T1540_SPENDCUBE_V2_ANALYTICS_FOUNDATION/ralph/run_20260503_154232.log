- Add interface CategoryQualityReport: { total_transactions: number; categorised_count: number; uncategorised_count: number; categorised_pct: number; by_method: {method: string; count: number; spend: number; avg_confidence: number}[]; by_confidence_band: {band: string; count: number; spend: number}[]; low_confidence_backlog: {transaction_id: string; raw_supplier_name?: string; base_amount: number; category_l1?: string; category_confidence?: number}[] }
